.hero {
  position: relative;
  /* 'dvh' (dynamic viewport height) é o padrão moderno. 
     Ele evita que a barra de endereços do celular corte o seu conteúdo, o que acontecia muito com o '100vh'. */
  min-height: 100dvh; 
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  padding: 2rem; /* Respiro de segurança para celulares */
}

.hero-grid {
  display: grid;
  /* Grid Fluido Inteligente: Fica 1 coluna no celular e 2 colunas no PC automaticamente */
  grid-template-columns: repeat(auto-fit, minmax(min(100%, 450px), 1fr));
  /* Usa clamp para que o espaçamento cresça e diminua suavemente com a tela */
  gap: clamp(2rem, 5vw, 4rem); 
  align-items: center;
  width: 100%;
  max-width: 1440px; /* Evita que o grid estique infinitamente em monitores ultrawide */
}

.hero h1 {
  /* Tipografia Fluida (Clamp): O tamanho varia de 2.5rem (celular) até 4.5rem (telas grandes) de forma suave */
  font-size: clamp(2.5rem, 5vw + 1rem, 4.5rem);
  line-height: 1.1;
  margin-bottom: clamp(1rem, 2vw, 1.5rem);
  
  /* Modernidade Visual: Texto com gradiente do branco para o Ciano Neon */
  background: linear-gradient(to right, #FFFFFF, var(--cyan-neon, #00F0FF));
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
}

.hero h1 span {
  display: block;
  /* Destaque sutil para quebras de linha dentro do h1 */
  text-shadow: 0 0 20px rgba(0, 240, 255, 0.3); 
}
